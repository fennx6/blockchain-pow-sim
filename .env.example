# Salin menjadi .env lalu sesuaikan. File .env TIDAK boleh di-commit.
# Semua nilai di sini juga punya default di config/settings.yaml.

# Blockchain
DIFFICULTY=4
MINING_MODE=compete
BLOCK_SIZE=50
CONFIRMATIONS=3

# Node
NODE_REST_PORT=8081
NODE_GRPC_PORT=50051
# NODE_ID diisi otomatis dari hostname container bila kosong.
# NODE_ID=node-1
# PEERS=node-2,node-3,node-4,node-5,node-6

# Coordinator
COORDINATOR_HOST=0.0.0.0
COORDINATOR_PORT=8080

# Jaringan
HEARTBEAT_INTERVAL_S=2.0
HEARTBEAT_TIMEOUT_S=1.0
GRPC_TIMEOUT_S=2.0
TX_FORWARD_TIMEOUT_S=2.0

# Logging
LOG_DIR=logs
LOG_LEVEL=INFO
