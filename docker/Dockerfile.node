# Image node worker: menyimpan rantai, memvalidasi blok, menambang, bergosip.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Dependensi dipasang lebih dulu agar layer cache stabil dan grpc_tools sudah
# tersedia saat kode gRPC dibangkitkan di langkah berikutnya.
COPY requirements.txt pyproject.toml ./
RUN pip install --no-cache-dir -r requirements.txt

COPY src ./src
COPY config ./config
COPY proto ./proto
# scripts/ ikut disalin karena tx_generator dipakai E4 lewat `compose exec`.
COPY scripts ./scripts
# E2/E4 dapat dijalankan di dalam network tanpa mount repo host. Hasil tetap
# ditulis ke volume/mount `experiments/results` saat dipanggil dengan --output-dir.
COPY experiments ./experiments

# File *_pb2*.py di-gitignore, jadi image harus membangkitkannya sendiri supaya
# build dari clone bersih tetap bisa mengimpor chainsim.generated.
RUN python scripts/gen_proto.py \
    && pip install --no-cache-dir --no-deps . \
    && python -c "from chainsim.generated import blockchain_pb2, blockchain_pb2_grpc"

RUN useradd --create-home --uid 10001 chainsim \
    && mkdir -p /app/logs /app/data \
    && chown -R chainsim:chainsim /app

USER chainsim

# Port hanya dipakai di dalam network chainnet, tidak dipublikasikan ke host.
EXPOSE 8081 50051

CMD ["python", "-m", "chainsim.node.main"]
