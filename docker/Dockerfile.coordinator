# Image coordinator: registry, heartbeat, pengumpul metrik, dashboard Flask.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY requirements.txt pyproject.toml ./
COPY src ./src
COPY config ./config

RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir --no-deps .

RUN useradd --create-home --uid 10001 chainsim \
    && mkdir -p /app/logs \
    && chown -R chainsim:chainsim /app

USER chainsim

EXPOSE 8080

CMD ["python", "-m", "chainsim.coordinator.main"]
